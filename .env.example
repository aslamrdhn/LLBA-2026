# ============================================================
# LedgerLine by Aslam — Environment Variables (.env.example)
# Rujukan: PRD v2 Bagian 15
# ============================================================

# Server & Runtime
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Database (Fase 0-1: SQLite; Fase 2+: PostgreSQL)
SQLITE_URL="file:./dev.db"
DATABASE_URL="file:./dev.db"

# Cache & Queues (Redis)
REDIS_URL=redis://localhost:6379

# Security & Session Secrets (Wajib diisi di produksi, min 32 karakter)
COOKIE_SECRET=change_this_to_a_random_32_character_secret_string_123
JWT_SECRET=change_this_to_a_random_32_character_jwt_secret_ok!
SECRETS_ENC_KEY=change_this_to_32_character_encryption_key_ok!

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_REF=

# Firebase Authentication (Wajib di produksi untuk verifikasi token Google)
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT=

# Superadmin Initial Bootstrap
SUPERADMIN_EMAIL=admin@ledgerline.local

# Optional Integrations
BREVO_API_KEY=
BREVO_SENDER=
TELEGRAM_BOT_TOKEN=
WORKER_MODE=inline
