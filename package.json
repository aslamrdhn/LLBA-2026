    "react-router-dom": "^7.18.0",
    "recharts": "^3.8.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.1",
