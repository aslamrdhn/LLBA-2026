    "@fastify/static": "^10.1.3",
    "@paralleldrive/cuid2": "^3.3.0",
    "@prisma/client": "^5.15.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.101.0",
    "@types/pg": "^8.20.0",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
