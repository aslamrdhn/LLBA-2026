{
  "name": "ledgerline",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "cross-env NODE_ENV=test NODE_TLS_REJECT_UNAUTHORIZED=0 tsx --test --test-concurrency=1 server/tests/**/*.test.ts",
    "test:p7": "cross-env NODE_ENV=test NODE_TLS_REJECT_UNAUTHORIZED=0 tsx --test server/tests/p7_procurement_migration_bcg.test.ts",
    "test:p8": "cross-env NODE_ENV=test NODE_TLS_REJECT_UNAUTHORIZED=0 tsx --test server/tests/p8_totp_queue_backup.test.ts",
    "backup:verify": "tsx scripts/backup-verify.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "cross-env NODE_ENV=production node dist/server.cjs",
    "admin:create": "tsx scripts/create-admin.ts",
    "skills": "node .agents/bin/cli.js",
    "clean": "rm -rf dist server.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
