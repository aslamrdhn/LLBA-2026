    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "csrf-sync": "^4.2.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "express-rate-limit": "^8.5.2",
    "fastify": "^5.12.3",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.1.0",
    "googleapis": "^173.0.0",
    "idb-keyval": "^6.2.6",
