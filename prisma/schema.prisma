// ============================================================
// GENERATOR & DATASOURCE
// ============================================================
generator client {
  
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// ENUM DEFINITIONS
// ============================================================












// ============================================================
// TENANT & AUTH (Phase 1)
// ============================================================
model Tenant {
  id                String    @id @default(uuid()) @map("id")
  name              String    @map("name")
  slug              String    @unique @map("slug")
  plan              String @default("cashier") @map("plan")
  planExpiresAt     DateTime? @map("plan_expires_at")
  status            String    @default("active") @map("status")
  isDemo            Boolean   @default(false) @map("is_demo")
  demoCreatedAt     DateTime? @map("demo_created_at")
  timezone          String    @default("Asia/Jakarta") @map("timezone")
  isTaxInclusive    Boolean   @default(false) @map("is_tax_inclusive")
  serviceChargeRate Float?  @default(0) @map("service_charge_rate") 
  config            String      @default("{}") @map("config")
  lifecycleStatus   String      @default("TRIAL") @map("lifecycle_status") // PROVISIONING, TRIAL, ACTIVE, PAST_DUE, RESTRICTED, SUSPENDED, ARCHIVED
  suspensionReason  String?     @map("suspension_reason")
  suspendedAt       DateTime?   @map("suspended_at")
  suspendedBy       String?     @map("suspended_by")
  onboardingStep    Int         @default(1) @map("onboarding_step")
  onboardingCompleted Boolean   @default(false) @map("onboarding_completed")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  outlets              Outlet[]
  userProfiles         UserProfile[]
  sales                SalesHeader[]
  returnOrders         ReturnOrder[]
  DemoSession          DemoSession[]
  Warehouse            Warehouse[]
  Unit                 Unit[]
  Item                 Item[]
  Menu                 Menu[]
  Recipe               Recipe[]
  RecipeDetail         RecipeDetail[]
  FifoAllocationJob    FifoAllocationJob[]
  Account              Account[]
  JournalEntry         JournalEntry[]
  Period               Period[]
  StockOpname          StockOpname[]
  Waste                Waste[]
  CostAllocationConfig CostAllocationConfig?
  Shift                Shift[]
  AttendanceLog        AttendanceLog[]
  PaymentMethod        PaymentMethod[]
  GoogleToken          GoogleToken?
  PurchaseOrder        PurchaseOrder[]
  Receiving            Receiving[]
  SupplierReview       SupplierReview[]
  QrMenu               QrMenu[]
  MigrationJob         MigrationJob[]
  DecisionAlert        DecisionAlert[]
  DailyMenuStat        DailyMenuStat[]
  VoidFallbackRetry    VoidFallbackRetry[]
  OfflineTransaction   OfflineTransaction[]
  ArchiveJob           ArchiveJob[]
  Outbox               Outbox[]
  TaxRate              TaxRate[]
  AuditLog             AuditLog[]
  Notification         Notification[]
  userOutlets          UserOutlet[]
  sessions             Session[]
  devices              Device[]
  accessRequests       AccessRequest[]
  subscription         TenantSubscription?
  supportSessions      SupportSession[]
  supportCases         SupportCase[]

  @@index([slug])
  @@index([status])
  @@index([lifecycleStatus])
  @@map("tenants")
}

model UserProfile {
  id              String    @id @default(uuid()) @map("id")
  userId          String    @unique @map("user_id")
  tenantId        String?   @map("tenant_id")
  supplierId      String?   @map("supplier_id")
  role            String      @map("role")
  email           String?   @unique @map("email")
  fullName        String?   @map("full_name")
  phone           String?   @map("phone")
  pinHash         String?   @map("pin_hash")
  deviceId        String?   @map("device_id")
  status          String    @default("active") @map("status")
  pinAttempts     Int       @default(0) @map("pin_attempts")
  pinLockedUntil  DateTime? @map("pin_locked_until")
  lastLoginAt     DateTime? @map("last_login_at")
  metadata        String      @default("{}") @map("metadata")
  assignedOutlets String?     @map("assigned_outlets")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant      Tenant?      @relation(fields: [tenantId], references: [id])
  supplier    Supplier?    @relation(fields: [supplierId], references: [id])
  userOutlets UserOutlet[]
  sessions    Session[]

  @@index([userId])
  @@index([email])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("user_profiles")
}

model DemoSession {
  id           String   @id @default(uuid()) @map("id")
  sessionToken String   @unique @map("session_token")
  tenantId     String   @map("tenant_id")
  expiresAt    DateTime @map("expires_at")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  metadata     String     @default("{}") @map("metadata")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([sessionToken])
  @@index([expiresAt])
  @@map("demo_sessions")
}

model UserOutlet {
  id        String   @id @default(uuid()) @map("id")
  userId    String   @map("user_id")
  outletId  String   @map("outlet_id")
  tenantId  String   @map("tenant_id")
  role      String   @default("BARISTA") @map("role")
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")

  userProfile UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  outlet      Outlet      @relation(fields: [outletId], references: [id], onDelete: Cascade)
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, outletId])
  @@index([tenantId, outletId])
  @@map("user_outlets")
}

model Session {
  id               String    @id @default(uuid()) @map("id")
  sessionTokenHash String    @unique @map("session_token_hash")
  userId           String    @map("user_id")
  tenantId         String?   @map("tenant_id")
  outletId         String?   @map("outlet_id")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  userProfile UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant      Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet      Outlet?     @relation(fields: [outletId], references: [id], onDelete: SetNull)

  @@index([userId, expiresAt])
  @@index([tenantId])
  @@map("sessions")
}

model Device {
  id           String    @id @default(uuid()) @map("id")
  tenantId     String    @map("tenant_id")
  outletId     String    @map("outlet_id")
  name         String    @map("name")
  deviceType   String    @default("POS") @map("device_type")
  fingerprint  String    @unique @map("fingerprint")
  trustedUntil DateTime? @map("trusted_until")
  status       String    @default("active") @map("status")
  lastSeenAt   DateTime? @map("last_seen_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@index([tenantId, outletId])
  @@map("devices")
}

model AccessRequest {
  id            String    @id @default(uuid()) @map("id")
  email         String    @map("email")
  fullName      String    @map("full_name")
  tenantId      String?   @map("tenant_id")
  requestedRole String    @default("KASIR") @map("requested_role")
  status        String    @default("PENDING") @map("status")
  reviewedBy    String?   @map("reviewed_by")
  reviewedAt    DateTime? @map("reviewed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([tenantId, status])
  @@map("access_requests")
}

// ============================================================
// MASTER DATA (Phase 1)
// ============================================================
model Outlet {
  id                 String   @id @default(uuid()) @map("id")
  tenantId           String   @map("tenant_id")
  name               String   @map("name")
  address            String?  @map("address")
  phone              String?  @map("phone")
  defaultWarehouseId String?  @map("default_warehouse_id")
  createdAt          DateTime @default(now()) @map("created_at")

  tenant             Tenant               @relation(fields: [tenantId], references: [id])
  defaultWarehouse   Warehouse?           @relation(fields: [defaultWarehouseId], references: [id])
  sales              SalesHeader[]
  kitchenOrders      KitchenOrder[]
  paymentMethods     PaymentMethod[]
  stockOpnames       StockOpname[]
  wastes             Waste[]
  shifts             Shift[]
  attendanceLogs     AttendanceLog[]
  returnOrders       ReturnOrder[]
  Receiving          Receiving[]
  QrMenu             QrMenu[]
  OfflineTransaction OfflineTransaction[]
  userOutlets        UserOutlet[]
  sessions           Session[]
  devices            Device[]

  @@index([tenantId])
  @@map("outlets")
}

model Warehouse {
  id        String   @id @default(uuid()) @map("id")
  tenantId  String   @map("tenant_id")
  name      String   @map("name")
  location  String?  @map("location")
  createdAt DateTime @default(now()) @map("created_at")

  tenant     Tenant             @relation(fields: [tenantId], references: [id])
  balances   InventoryBalance[]
  fifoLayers FifoLayer[]
  Outlet     Outlet[]

  @@index([tenantId])
  @@map("warehouses")
}

model Unit {
  id        String   @id @default(uuid()) @map("id")
  tenantId  String   @map("tenant_id")
  name      String   @map("name")
  symbol    String   @map("symbol")
  createdAt DateTime @default(now()) @map("created_at")

  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  items        Item[]
  RecipeDetail RecipeDetail[]

  @@unique([tenantId, symbol])
  @@index([tenantId])
  @@map("units")
}

model Item {
  id        String   @id @default(uuid()) @map("id")
  tenantId  String   @map("tenant_id")
  sku       String   @map("sku")
  name      String   @map("name")
  price     Float  @default(0) @map("price") 
  category  String   @map("category")
  unitId    String   @map("unit_id")
  minStock  Float? @map("min_stock") 
  status    String   @default("ACTIVE") @map("status")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant           Tenant             @relation(fields: [tenantId], references: [id])
  unit             Unit               @relation(fields: [unitId], references: [id])
  balances         InventoryBalance[]
  fifoLayers       FifoLayer[]
  recipeDetails    RecipeDetail[]
  stockOpnames     StockOpname[]
  wastes           Waste[]
  receivingDetails ReceivingDetail[]
  returnDetails    ReturnDetail[]

  @@unique([tenantId, sku])
  @@index([tenantId, status])
  @@map("items")
}

model Menu {
  id          String   @id @default(uuid()) @map("id")
  tenantId    String   @map("tenant_id")
  name        String   @map("name")
  price       Float  @map("price") 
  category    String   @map("category")
  description String?  @map("description")
  imageUrl    String?  @map("image_url")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  recipes       Recipe[]
  salesDetails  SalesDetail[]
  DailyMenuStat DailyMenuStat[]

  @@index([tenantId, isActive])
  @@index([tenantId, category])
  @@map("menus")
}

model Recipe {
  id             String    @id @default(uuid()) @map("id")
  tenantId       String    @map("tenant_id")
  menuId         String    @map("menu_id")
  version        Int       @default(1) @map("version")
  effectiveFrom  DateTime  @map("effective_from")
  effectiveUntil DateTime? @map("effective_until")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  menu        Menu           @relation(fields: [menuId], references: [id])
  details     RecipeDetail[]
  SalesDetail SalesDetail[]

  @@unique([menuId, version])
  @@index([tenantId, menuId, effectiveFrom])
  @@map("recipes")
}

model RecipeDetail {
  id        String   @id @default(uuid()) @map("id")
  tenantId  String   @map("tenant_id")
  recipeId  String   @map("recipe_id")
  itemId    String   @map("item_id")
  unitId    String   @map("unit_id")
  quantity  Float  @map("quantity") 
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  recipe Recipe @relation(fields: [recipeId], references: [id])
  item   Item   @relation(fields: [itemId], references: [id])
  unit   Unit   @relation(fields: [unitId], references: [id])

  @@index([tenantId, recipeId])
  @@map("recipe_details")
}

// ============================================================
// INVENTORY & COST ENGINE (Phase 2)
// ============================================================
model InventoryBalance {
  id           String   @id @default(uuid()) @map("id")
  tenantId     String   @map("tenant_id")
  itemId       String   @map("item_id")
  warehouseId  String   @map("warehouse_id")
  currentStock Float  @default(0) @map("current_stock") 
  averageCost  Float? @default(0) @map("average_cost") 
  version      Int      @default(0) @map("version")
  lastUpdated  DateTime @default(now()) @map("last_updated")

  item      Item      @relation(fields: [itemId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([tenantId, itemId, warehouseId])
  @@index([tenantId, itemId, warehouseId])
  @@index([tenantId, itemId, currentStock])
  @@map("inventory_balance")
}

model FifoLayer {
  id           String   @id @default(uuid()) @map("id")
  tenantId     String   @map("tenant_id")
  itemId       String   @map("item_id")
  warehouseId  String   @map("warehouse_id")
  batchNumber  String   @map("batch_number")
  quantity     Float  @map("quantity") 
  remainingQty Float  @map("remaining_qty") 
  unitCost     Float  @map("unit_cost") 
  layerDate    DateTime @map("layer_date")
  isExhausted  Boolean  @default(false) @map("is_exhausted")
  isVirtual    Boolean  @default(false) @map("is_virtual")
  virtualCost  Float? @map("virtual_cost") 
  version      Int      @default(0) @map("version")
  lastUpdated  DateTime @default(now()) @map("last_updated")
  createdAt    DateTime @default(now()) @map("created_at")

  item         Item              @relation(fields: [itemId], references: [id])
  warehouse    Warehouse         @relation(fields: [warehouseId], references: [id])
  consumptions FifoConsumption[]

  @@index([tenantId, itemId, layerDate(sort: Asc), remainingQty])
  @@index([tenantId, itemId, warehouseId, remainingQty])
  @@index([tenantId, itemId, warehouseId, version])
  @@index([tenantId, isVirtual])
  @@map("fifo_layers")
}

model FifoConsumption {
  id               String   @id @default(uuid()) @map("id")
  tenantId         String   @map("tenant_id")
  layerId          String   @map("layer_id")
  itemId           String   @map("item_id")
  salesId          String?  @map("sales_id")
  quantityConsumed Float  @map("quantity_consumed") 
  unitCostAtTime   Float  @map("unit_cost_at_time") 
  consumptionDate  DateTime @default(now()) @map("consumption_date")

  layer FifoLayer    @relation(fields: [layerId], references: [id])
  sales SalesHeader? @relation(fields: [salesId], references: [id])

  @@index([tenantId, salesId])
  @@index([tenantId, layerId])
  @@map("fifo_consumptions")
}

model FifoAllocationJob {
  id           String    @id @default(uuid()) @map("id")
  tenantId     String    @map("tenant_id")
  salesId      String    @map("sales_id")
  allocations  String      @map("allocations")
  status       String    @default("PENDING") @map("status")
  retryCount   Int       @default(0) @map("retry_count")
  maxRetry     Int       @default(3) @map("max_retry")
  errorMessage String?   @map("error_message")
  createdAt    DateTime  @default(now()) @map("created_at")
  completedAt  DateTime? @map("completed_at")

  tenant Tenant      @relation(fields: [tenantId], references: [id])
  sales  SalesHeader @relation(fields: [salesId], references: [id])

  @@index([tenantId, status, createdAt])
  @@map("fifo_allocation_jobs")
}

model InventoryLedger {
  id            String   @id @default(uuid()) @map("id")
  tenantId      String   @map("tenant_id")
  outletId      String   @map("outlet_id")
  warehouseId   String   @map("warehouse_id")
  itemId        String   @map("item_id")
  movementType  String   @map("movement_type")
  referenceType String   @map("reference_type")
  referenceId   String   @map("reference_id")
  businessDate  DateTime @map("business_date")
  qtyIn         Float  @default(0) @map("qty_in") 
  qtyOut        Float  @default(0) @map("qty_out") 
  balanceAfter  Float  @map("balance_after") 
  unitCost      Float  @default(0) @map("unit_cost") 
  costMethod    String   @map("cost_method")
  unitSnapshot  String   @map("unit_snapshot")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([tenantId, referenceId])
  @@index([tenantId, itemId, businessDate])
  @@index([tenantId, movementType])
  @@map("inventory_ledger")
}

// ============================================================
// POS & SALES (Phase 2)
// ============================================================
model SalesHeader {
  id                     String      @id @default(uuid()) @map("id")
  tenantId               String      @map("tenant_id")
  outletId               String      @map("outlet_id")
  warehouseId            String?     @map("warehouse_id")
  invoiceNumber          String      @map("invoice_number")
  businessDate           DateTime    @map("business_date")
  originalBusinessDate   DateTime?   @map("original_business_date")
  cashierId              String      @map("cashier_id")
  subtotal               Float     @map("subtotal") 
  discount               Float     @default(0) @map("discount") 
  tax                    Float     @default(0) @map("tax") 
  serviceCharge          Float     @default(0) @map("service_charge") 
  totalAmount            Float     @map("total_amount") 
  totalHpp               Float?    @map("total_hpp") 
  hppJournalLineId       String?     @map("hpp_journal_line_id")
  inventoryJournalLineId String?     @map("inventory_journal_line_id")
  isHppCalculated        Boolean     @default(false) @map("is_hpp_calculated")
  hppEstimated           Boolean     @default(false) @map("hpp_estimated")
  status                 String @default("POSTED") @map("status")
  idempotencyKey         String?     @map("idempotency_key")
  offlineId              String?     @map("offline_id")
  voidedAt               DateTime?   @map("voided_at")
  voidedBy               String?     @map("voided_by")
  voidReason             String?     @map("void_reason")
  note                   String?     @map("note")
  metadata               String?       @map("metadata")
  createdAt              DateTime    @default(now()) @map("created_at")

  tenant            Tenant              @relation(fields: [tenantId], references: [id])
  outlet            Outlet              @relation(fields: [outletId], references: [id])
  details           SalesDetail[]
  payments          Payment[]
  fifoConsumptions  FifoConsumption[]
  kitchenOrder      KitchenOrder?
  returnOrders      ReturnOrder[]
  FifoAllocationJob FifoAllocationJob[]

  @@unique([tenantId, invoiceNumber])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, businessDate])
  @@index([tenantId, status])
  @@index([tenantId, cashierId, businessDate])
  @@index([tenantId, offlineId])
  @@index([tenantId, originalBusinessDate])
  @@map("sales_headers")
}

model SalesDetail {
  id                    String    @id @default(uuid()) @map("id")
  salesId               String    @map("sales_id")
  menuId                String    @map("menu_id")
  recipeVersionId       String?   @map("recipe_version_id")
  recipeSnapshot        String?     @map("recipe_snapshot")
  menuNameSnapshot      String    @map("menu_name_snapshot")
  unitPriceSnapshot     Float   @map("unit_price_snapshot") 
  quantity              Int       @map("quantity")
  totalPrice            Float   @map("total_price") 
  hpp                   Float   @default(0) @map("hpp") 
  costingMethodSnapshot String    @default("FIFO") @map("costing_method_snapshot")
  hppStatus             String @default("PENDING_ALLOCATION") @map("hpp_status")
  refundedQty           Int       @default(0) @map("refunded_qty")

  sales         SalesHeader    @relation(fields: [salesId], references: [id])
  menu          Menu           @relation(fields: [menuId], references: [id])
  recipeVersion Recipe?        @relation(fields: [recipeVersionId], references: [id])
  returnDetails ReturnDetail[]

  @@index([salesId])
  @@index([menuId])
  @@map("sales_details")
}

model Payment {
  id        String   @id @default(uuid()) @map("id")
  salesId   String   @map("sales_id")
  method    String   @map("method")
  amount    Float  @map("amount") 
  status    String   @default("PAID") @map("status")
  createdAt DateTime @default(now()) @map("created_at")

  sales SalesHeader @relation(fields: [salesId], references: [id])

  @@index([salesId])
  @@map("payments")
}

// ============================================================
// FINANCE & ACCOUNTING (Phase 2)
// ============================================================
model Account {
  id            String   @id @default(uuid()) @map("id")
  tenantId      String   @map("tenant_id")
  code          String   @map("code")
  name          String   @map("name")
  type          String   @map("type")
  normalBalance String   @map("normal_balance")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  journalLines JournalLine[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("accounts")
}

model JournalEntry {
  id            String   @id @default(uuid()) @map("id")
  tenantId      String   @map("tenant_id")
  entryNumber   String   @map("entry_number")
  entryDate     DateTime @map("entry_date")
  referenceType String   @map("reference_type")
  referenceId   String   @map("reference_id")
  description   String   @map("description")
  status        String   @default("POSTED") @map("status")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  lines  JournalLine[]

  @@unique([tenantId, entryNumber])
  @@index([tenantId, referenceId])
  @@index([tenantId, entryDate])
  @@map("journal_entries")
}

model JournalLine {
  id             String   @id @default(uuid()) @map("id")
  journalEntryId String   @map("journal_entry_id")
  accountId      String   @map("account_id")
  debit          Float  @default(0) @map("debit") 
  credit         Float  @default(0) @map("credit") 
  createdAt      DateTime @default(now()) @map("created_at")

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id])
  account      Account      @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_lines")
}

model Period {
  id         String    @id @default(uuid()) @map("id")
  tenantId   String    @map("tenant_id")
  name       String    @map("name")
  startDate  DateTime  @map("start_date")
  endDate    DateTime  @map("end_date")
  status     String    @default("OPEN") @map("status")
  closedAt   DateTime? @map("closed_at")
  reopenedAt DateTime? @map("reopened_at")
  reopenedBy String?   @map("reopened_by")
  createdAt  DateTime  @default(now()) @map("created_at")

  tenant     Tenant       @relation(fields: [tenantId], references: [id])
  ArchiveJob ArchiveJob[]

  @@index([tenantId, status])
  @@index([tenantId, startDate, endDate])
  @@map("periods")
}

// ============================================================
// BUSINESS MODULES (Phase 3)
// ============================================================
model StockOpname {
  id                String    @id @default(uuid()) @map("id")
  tenantId          String    @map("tenant_id")
  outletId          String    @map("outlet_id")
  itemId            String    @map("item_id")
  systemStock       Float   @map("system_stock") 
  physicalStock     Float   @map("physical_stock") 
  difference        Float   @map("difference") 
  estimatedUnitCost Float?  @map("estimated_unit_cost") 
  notes             String?   @map("notes")
  status            String    @default("draft") @map("status")
  confirmedBy       String?   @map("confirmed_by")
  confirmedAt       DateTime? @map("confirmed_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  outlet Outlet @relation(fields: [outletId], references: [id])
  item   Item   @relation(fields: [itemId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, outletId])
  @@map("stock_opnames")
}

