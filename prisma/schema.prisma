// ============================================================
// SAAS PLATFORM CONTROL PLANE & SUBSCRIPTIONS
// ============================================================

model SubscriptionPlan {
  id           String   @id @default(uuid()) @map("id")
  code         String   @unique @map("code") // CORE, GROWTH, SCALE, ENTERPRISE
  name         String   @map("name")
  description  String?  @map("description")
  priceMonthly Float    @map("price_monthly")
  priceYearly  Float    @map("price_yearly")
  currency     String   @default("IDR") @map("currency")
  version      Int      @default(1) @map("version")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  entitlements  PlanEntitlement[]
  subscriptions TenantSubscription[]

  @@map("subscription_plans")
}

model PlanEntitlement {
  id           String   @id @default(uuid()) @map("id")
  planId       String   @map("plan_id")
  featureKey   String   @map("feature_key")
  featureValue String   @map("feature_value")
  createdAt    DateTime @default(now()) @map("created_at")

  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
  @@map("plan_entitlements")
}

model TenantSubscription {
  id                 String    @id @default(uuid()) @map("id")
  tenantId           String    @unique @map("tenant_id")
  planId             String    @map("plan_id")
  status             String    @default("TRIALING") @map("status") // TRIALING, ACTIVE, PAST_DUE, GRACE_PERIOD, RESTRICTED, CANCELED
  trialStartsAt      DateTime? @map("trial_starts_at")
  trialEndsAt        DateTime? @map("trial_ends_at")
  currentPeriodStart DateTime  @default(now()) @map("current_period_start")
  currentPeriodEnd   DateTime  @map("current_period_end")
  graceEndsAt        DateTime? @map("grace_ends_at")
  cancelAtPeriodEnd  Boolean   @default(false) @map("cancel_at_period_end")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  tenant   Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan     @relation(fields: [planId], references: [id])
  invoices SubscriptionInvoice[]
  events   SubscriptionEvent[]

  @@index([status])
  @@map("tenant_subscriptions")
}

model SubscriptionInvoice {
  id              String    @id @default(uuid()) @map("id")
  subscriptionId  String    @map("subscription_id")
  invoiceNumber   String    @unique @map("invoice_number")
  amount          Float     @map("amount")
  status          String    @default("PENDING") @map("status") // PENDING, PAID, PAST_DUE, VOID
  dueAt           DateTime  @map("due_at")
  paidAt          DateTime? @map("paid_at")
  paymentMethod   String?   @map("payment_method")
  paymentProofUrl String?   @map("payment_proof_url")
  metadata        String?   @map("metadata")
  createdAt       DateTime  @default(now()) @map("created_at")

  subscription TenantSubscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  payments     SubscriptionPayment[]

  @@index([status, dueAt])
  @@map("subscription_invoices")
}

model SubscriptionPayment {
  id         String    @id @default(uuid()) @map("id")
  invoiceId  String    @map("invoice_id")
  amount     Float     @map("amount")
  method     String    @map("method")
  reference  String?   @map("reference")
  paidAt     DateTime  @default(now()) @map("paid_at")
  verifiedBy String?   @map("verified_by")
  verifiedAt DateTime? @map("verified_at")

  invoice SubscriptionInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("subscription_payments")
}

model SubscriptionEvent {
  id             String   @id @default(uuid()) @map("id")
  subscriptionId String   @map("subscription_id")
  eventType      String   @map("event_type") // TRIAL_STARTED, UPGRADED, PAYMENT_CONFIRMED, PAST_DUE, RESTRICTED, CANCELED
  fromStatus     String?  @map("from_status")
  toStatus       String   @map("to_status")
  actorId        String?  @map("actor_id")
  metadata       String   @default("{}") @map("metadata")
  createdAt      DateTime @default(now()) @map("created_at")

  subscription TenantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt])
  @@map("subscription_events")
}

model SupportSession {
  id           String    @id @default(uuid()) @map("id")
  adminId      String    @map("admin_id")
  tenantId     String    @map("tenant_id")
  ticketNumber String    @map("ticket_number")
  reason       String    @map("reason")
  mode         String    @default("READ_ONLY") @map("mode") // READ_ONLY, WRITE_OVERRIDE
  startedAt    DateTime  @default(now()) @map("started_at")
  expiresAt    DateTime  @map("expires_at")
  endedAt      DateTime? @map("ended_at")
  actionLogs   String    @default("[]") @map("action_logs")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, startedAt])
  @@index([adminId, startedAt])
  @@map("support_sessions")
}

model SupportCase {
  id             String    @id @default(uuid()) @map("id")
  tenantId       String    @map("tenant_id")
  ticketNumber   String    @unique @map("ticket_number")
  category       String    @map("category") // RECONCILIATION_FAILED, SHIFT_CLOSING, GOOGLE_SYNC, HARDWARE, BILLING, GENERAL
  priority       String    @default("MEDIUM") @map("priority") // LOW, MEDIUM, HIGH, CRITICAL
  status         String    @default("OPEN") @map("status") // OPEN, INVESTIGATING, RESOLVED, CLOSED
  subject        String    @map("subject")
  description    String    @map("description")
  diagnosticData String?   @map("diagnostic_data")
  adminNote      String?   @map("admin_note")
  resolution     String?   @map("resolution")
  resolvedAt     DateTime? @map("resolved_at")
  resolvedBy     String?   @map("resolved_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([category, status])
  @@map("support_cases")
}

model SystemKillSwitch {
  id            String   @id @default(uuid()) @map("id")
  serviceKey    String   @unique @map("service_key") // GOOGLE_SYNC, POS_OFFLINE_SYNC, SUPPLY_ORDER, MIGRATION_COMMIT, EXPORT
  isKilled      Boolean  @default(false) @map("is_killed")
  reason        String?  @map("reason")
  affectedCount Int      @default(0) @map("affected_count")
  updatedBy     String?  @map("updated_by")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("system_kill_switches")
}

model FeatureFlag {
  id              String   @id @default(uuid()) @map("id")
  key             String   @unique @map("key")
  description     String   @map("description")
  isEnabledGlobal Boolean  @default(false) @map("is_enabled_global")
  tenantOverrides String   @default("{}") @map("tenant_overrides") // JSON string { "tenantId": true }
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

